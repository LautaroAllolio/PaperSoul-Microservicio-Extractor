PDFEXTRACTOR_HOST=0.0.0.0
PDFEXTRACTOR_PORT=9000                 # 8001 en dev local; 9000 en Docker (http://extractor:9000)
PDFEXTRACTOR_MAX_UPLOAD_BYTES=52428800        # 50 MB
PDFEXTRACTOR_MIN_TEXT_LENGTH=0         # 0 en Docker: el orquestador acepta texto vacío (PDF escaneado)
# default: one per CPU
PDFEXTRACTOR_WORKERS=
# default: worker count
PDFEXTRACTOR_MAX_CONCURRENT_EXTRACTIONS=
PDFEXTRACTOR_QUEUE_TIMEOUT_SECONDS=5.0
PDFEXTRACTOR_EXTRACTION_TIMEOUT_SECONDS=30.0
PDFEXTRACTOR_MAX_PAGES=1000            # anti decompression-bomb: tope de páginas
PDFEXTRACTOR_MAX_EXTRACTED_CHARS=5000000   # anti decompression-bomb: tope de texto extraído
PDFEXTRACTOR_METRICS_ENABLED=true
PDFEXTRACTOR_LOG_LEVEL=INFO
