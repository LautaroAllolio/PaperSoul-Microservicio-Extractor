PDFEXTRACTOR_HOST=0.0.0.0
PDFEXTRACTOR_PORT=9000                 # 8001 en dev local; 9000 en Docker (http://extractor:9000)
PDFEXTRACTOR_MAX_UPLOAD_BYTES=52428800        # 50 MB
PDFEXTRACTOR_MIN_TEXT_LENGTH=0         # 0 en Docker: el orquestador acepta texto vacío (PDF escaneado)
# default: one per CPU
PDFEXTRACTOR_WORKERS=
# 7 = tuning medido para una instancia (docs/report.md §10.4/§10.5).
# Capacidad por instancia: ≤200 rps (~99 % de éxito); la rodilla está en ~250-270 rps.
# Multi-réplica: k = ceil(demanda_agregada / 200) réplicas detrás de Traefik (ver README).
PDFEXTRACTOR_MAX_CONCURRENT_EXTRACTIONS=7
# Puerta del event loop (TASK-37): peticiones admitidas a la vez.
# Por defecto = MAX_CONCURRENT_EXTRACTIONS (el loop nunca sostiene más trabajo del que
# la instancia puede terminar). El exceso se rechaza con 503 {"error":"overloaded"}
# tras PDFEXTRACTOR_QUEUE_TIMEOUT_SECONDS, sin leer el cuerpo; /health, /ready y
# /metrics están exentos. Medido a 400 rps mixtos: 85.46 % de éxito, p99 2.1 s,
# cero timeouts de cliente (docs/report.md §10.6).
PDFEXTRACTOR_MAX_INFLIGHT_REQUESTS=
PDFEXTRACTOR_QUEUE_TIMEOUT_SECONDS=5.0
PDFEXTRACTOR_EXTRACTION_TIMEOUT_SECONDS=30.0
PDFEXTRACTOR_MAX_PAGES=1000            # anti decompression-bomb: tope de páginas
PDFEXTRACTOR_MAX_EXTRACTED_CHARS=5000000   # anti decompression-bomb: tope de texto extraído
PDFEXTRACTOR_WARMUP=true               # precalienta workers al arrancar (evita cold-start de forkserver)
PDFEXTRACTOR_METRICS_ENABLED=true
# Cache de la exposición Prometheus (s): una tormenta de scrapes colapsa en un render
# por TTL. 0 desactiva la cache.
PDFEXTRACTOR_METRICS_CACHE_TTL_SECONDS=1.0
PDFEXTRACTOR_LOG_LEVEL=INFO
